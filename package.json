{
	"name": "n8n-nodes-relvato",
	"version": "0.1.0",
	"description": "Relvato website monitoring for n8n: trigger workflows when a site goes down, a monitor finds a problem or a vulnerability appears, and add sites, run monitors, pause groups and create heartbeats.",
	"license": "MIT",
	"homepage": "https://www.relvato.com/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"relvato",
		"website monitoring",
		"uptime",
		"wordpress",
		"woocommerce"
	],
	"author": {
		"name": "Relvato",
		"email": "contact@relvato.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Relvato/n8n-nodes-relvato.git"
	},
	"bugs": {
		"url": "https://github.com/Relvato/n8n-nodes-relvato/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/RelvatoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Relvato/Relvato.node.js",
			"dist/nodes/RelvatoTrigger/RelvatoTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
